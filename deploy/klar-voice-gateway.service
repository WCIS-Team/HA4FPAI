[Unit]
Description=klar voice gateway (ASR+TTS+KWS in ONE process, shared onnxruntime)
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/data/klar
Environment=KLAR_VOICE_JSON=/root/klar-voice.json
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /mnt/data/klar/voice_gateway.py
Restart=on-failure
RestartSec=5
# 合并后三个服务共用一个进程。合并前三个分别 199.8+113.0+55.5 = 368 MB，
# 预计合并后 ~308 MB（省掉重复的解释器/numpy 底座约 60 MB）。
MemoryMax=420M
StandardOutput=append:/mnt/data/klar/gateway.log
StandardError=append:/mnt/data/klar/gateway.log

[Install]
WantedBy=multi-user.target
