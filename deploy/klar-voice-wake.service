[Unit]
Description=klar voice wake/KWS (Wyoming, sherpa-onnx keyword spotter)
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/data/klar
Environment=KLAR_VOICE_JSON=/root/klar-voice.json
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /mnt/data/klar/klar_wake.py --uri tcp://0.0.0.0:10300
Restart=on-failure
RestartSec=5
MemoryMax=192M
StandardOutput=append:/mnt/data/klar/wake.log
StandardError=append:/mnt/data/klar/wake.log

[Install]
WantedBy=multi-user.target
