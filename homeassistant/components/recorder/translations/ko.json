    "issues": {
        "backup_failed_out_of_resources": {
            "description": "\ub370\uc774\ud130\ubca0\uc774\uc2a4 \ubc31\uc5c5\uc774 \uc2dc\uc791\ub418\uc5c8\uc2b5\ub2c8\ub2e4. {start_time} \ub9ac\uc18c\uc2a4 \ubd80\uc871\uc73c\ub85c \uc778\ud574 \uc2e4\ud328\ud588\uc2b5\ub2c8\ub2e4. \ubc31\uc5c5\uc744 \uc2e0\ub8b0\ud560 \uc218 \uc5c6\uc73c\ubbc0\ub85c \ub2e4\uc2dc \uc2dc\uc791\ud574\uc57c \ud569\ub2c8\ub2e4. \ub370\uc774\ud130\ubca0\uc774\uc2a4 \ud06c\uae30\uac00 \ub108\ubb34 \ud06c\uac70\ub098 \uc2dc\uc2a4\ud15c \ubd80\ud558\uac00 \uc2ec\ud55c \uacbd\uc6b0 \uc774\ub7ec\ud55c \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2dc\uc2a4\ud15c \ud558\ub4dc\uc6e8\uc5b4\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uac70\ub098, \ubcf4\uad00\ud560 \uae30\ub85d \uc77c\uc218\ub97c \uc904\uc774\uac70\ub098 \ud544\ud130\ub97c \uc0dd\uc131\ud558\uc5ec \ub370\uc774\ud130\ubca0\uc774\uc2a4 \ud06c\uae30\ub97c \uc904\uc774\ub294 \uac83\uc744 \uace0\ub824\ud574 \ubcf4\uc138\uc694.",
