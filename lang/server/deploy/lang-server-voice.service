[Unit]
Description=lang/server voice (Wyoming wake:10300 / asr:10301 / tts:10302; replaces HA4FPAI voice_gateway)
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/data/lang/server
Environment=LANG_CONFIG_DIR=/mnt/data/lang/config
EnvironmentFile=-/etc/lang-server.env
ExecStartPre=/usr/bin/mkdir -p /mnt/data/lang/server/cache
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /mnt/data/lang/server/wyoming_gateway.py
Restart=always
RestartSec=5
# 三语音合一进程；启动即 warm。合并前 368 MB、合并后 ~308 MB，给 warm 后留余量。
MemoryMax=600M
StandardOutput=append:/mnt/data/lang/server/voice.log
StandardError=append:/mnt/data/lang/server/voice.log

[Install]
WantedBy=multi-user.target
