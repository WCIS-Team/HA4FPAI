[Unit]
Description=HA4FPAI unified console (voice chain + klar + board APIs, one page)
# 语音已移交 lang/server：依赖的新语音单元是 lang-server-voice（10300-10302 不变）
After=network.target klar-nlu-engine.service lang-server-voice.service

[Service]
Type=simple
WorkingDirectory=/mnt/data/klar
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /mnt/data/klar/console.py --port 10900
Restart=on-failure
RestartSec=5
# http.server + 标准库，很轻
MemoryMax=96M
StandardOutput=append:/mnt/data/klar/console.log
StandardError=append:/mnt/data/klar/console.log

[Install]
WantedBy=multi-user.target
