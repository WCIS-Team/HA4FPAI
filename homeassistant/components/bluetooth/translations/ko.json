    "issues": {
        "bluetooth_adapter_missing_permissions": {
            "description": "\ube14\ub8e8\ud22c\uc2a4 \uc5b4\ub311\ud130 **{adapter}** ({model}\ucee8\ud14c\uc774\ub108\uac00 \ube14\ub8e8\ud22c\uc2a4 \ud558\ub4dc\uc6e8\uc5b4\uc5d0 \uc644\uc804\ud788 \uc811\uadfc\ud558\uae30 \uc704\ud574 \ucd94\uac00 \uad8c\ud55c\uc774 \ud544\uc694\ud558\ubbc0\ub85c \ud574\ub2f9 \uae30\ub2a5\uc740 \uc800\ud558\ub41c \ubaa8\ub4dc\ub85c \uc791\ub3d9\ud569\ub2c8\ub2e4.\n\ud544\uc694\ud55c \uad8c\ud55c\uc744 \ucd94\uac00\ud558\ub824\uba74 \ubb38\uc11c\uc5d0 \uc788\ub294 \uc9c0\uce68\uc744 \ub530\ub974\uc2ed\uc2dc\uc624.\n[\ub3c4\ucee4\uc6a9 \ube14\ub8e8\ud22c\uc2a4 \uad8c\ud55c]({docs_url})\n\uc774\ub7ec\ud55c \uad8c\ud55c\uc744 \ucd94\uac00\ud55c \ud6c4\uc5d0\ub294 \ubcc0\uacbd \uc0ac\ud56d\uc774 \uc801\uc6a9\ub418\ub3c4\ub85d Home Assistant \ucee8\ud14c\uc774\ub108\ub97c \ub2e4\uc2dc \uc2dc\uc791\ud558\uc138\uc694.",
            "title": "\ube14\ub8e8\ud22c\uc2a4 \uc5b4\ub311\ud130\uc5d0\ub294 \ucd94\uac00 \uad8c\ud55c\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."
        },
        "bluetooth_adapter_passive_mode_uart": {
            "description": "\ube14\ub8e8\ud22c\uc2a4 \uc5b4\ub311\ud130 **{adapter}** ({model})\uac00 \ub2a5\ub3d9 \uc2a4\uce94 \ubaa8\ub4dc\ub97c \uc694\uccad\ud588\uc9c0\ub9cc \uc218\ub3d9 \uc2a4\uce94 \ubaa8\ub4dc\uc5d0\uc11c \ubc97\uc5b4\ub098\uc9c0 \ubabb\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. **\uc790\ub3d9 \ubcf5\uad6c\ub97c \uc2dc\ub3c4\ud588\uc9c0\ub9cc \uc2e4\ud328\ud588\uc2b5\ub2c8\ub2e4.** \ucee4\ub110, \ud38c\uc6e8\uc5b4 \ub610\ub294 \uc6b4\uc601 \uccb4\uc81c \ubb38\uc81c\uc77c \uac00\ub2a5\uc131\uc774 \uc788\uc73c\uba70, \uc5b4\ub311\ud130\ub97c \ubcf5\uad6c\ud558\ub824\uba74 \uc2dc\uc2a4\ud15c \uc804\uc6d0\uc744 \uc644\uc804\ud788 \uaed0\ub2e4 \ucf1c\uc57c \ud569\ub2c8\ub2e4.\n\n\uc218\ub3d9 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc5b4\ub311\ud130\uac00 BLE \uc2e0\ud638\ub97c \uc218\uc2e0\ud560 \uc218\ub9cc \uc788\uace0 \uae30\uae30\uc5d0 \ucd94\uac00 \ub370\uc774\ud130\ub97c \uc694\uccad\ud560 \uc218 \uc5c6\uc73c\ubbc0\ub85c \uae30\uae30 \uac80\uc0c9\uacfc \uae30\ub2a5\uc5d0 \uc601\ud5a5\uc744 \uc90d\ub2c8\ub2e4.\n\n**\uc218\ub3d9 \uc870\uce58 \ud544\uc694:**\n1. **\uc2dc\uc2a4\ud15c\uc744 \uc644\uc804\ud788 \uc885\ub8cc\ud569\ub2c8\ub2e4**(\ub2e8\uc21c \uc7ac\ubd80\ud305\uc774 \uc544\ub2d8).\n2. **\uc804\uc6d0\uc744 \ucc28\ub2e8\ud569\ub2c8\ub2e4**(\ud50c\ub7ec\uadf8\ub97c \ubf51\uac70\ub098 \uc2a4\uc704\uce58\ub97c \ub054).\n3. 10\ucd08 \ub3d9\uc548 \uae30\ub2e4\ub9bd\ub2c8\ub2e4.\n4. \uc804\uc6d0\uc744 \ub2e4\uc2dc \uc5f0\uacb0\ud558\uace0 \uc2dc\uc2a4\ud15c\uc744 \ubd80\ud305\ud569\ub2c8\ub2e4.\n\n\uc804\uc6d0\uc744 \uaed0\ub2e4 \ucf20 \ud6c4\uc5d0\ub3c4 \ubb38\uc81c\uac00 \uc9c0\uc18d\ub418\uba74:\n- \ucee4\ub110/\ud38c\uc6e8\uc5b4 \uc5c5\ub370\uc774\ud2b8\ub97c \ud655\uc778\ud558\uc138\uc694.\n- \ub0b4\uc7a5 \ube14\ub8e8\ud22c\uc2a4 \uc5b4\ub311\ud130\uc5d0 \ud558\ub4dc\uc6e8\uc5b4 \ubb38\uc81c\uac00 \uc788\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
            "title": "\ube14\ub8e8\ud22c\uc2a4 \uc5b4\ub311\ud130\ub97c \uc0ac\uc6a9\ud558\ub824\uba74 \uc2dc\uc2a4\ud15c \uc804\uc6d0\uc744 \uaed0\ub2e4 \ucf1c\uc57c \ud569\ub2c8\ub2e4."
        },
        "bluetooth_adapter_passive_mode_usb": {
            "description": "\ube14\ub8e8\ud22c\uc2a4 \uc5b4\ub311\ud130 **{adapter}** ({model})\uac00 \ub2a5\ub3d9 \uc2a4\uce94 \ubaa8\ub4dc\ub97c \uc694\uccad\ud588\uc9c0\ub9cc \uc218\ub3d9 \uc2a4\uce94 \ubaa8\ub4dc\uc5d0\uc11c \ubc97\uc5b4\ub098\uc9c0 \ubabb\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. **\uc790\ub3d9 \ubcf5\uad6c\ub97c \uc2dc\ub3c4\ud588\uc9c0\ub9cc \uc2e4\ud328\ud588\uc2b5\ub2c8\ub2e4.** \ucee4\ub110, \ud38c\uc6e8\uc5b4 \ub610\ub294 \uc6b4\uc601 \uccb4\uc81c \ubb38\uc81c\uc77c \uac00\ub2a5\uc131\uc774 \uc788\uc73c\uba70, \uc5b4\ub311\ud130\ub97c \ubcf5\uad6c\ud558\ub824\uba74 \uc218\ub3d9\uc73c\ub85c \uc804\uc6d0\uc744 \uaed0\ub2e4 \ucf1c\uc57c \ud569\ub2c8\ub2e4.\n\n\uc218\ub3d9 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc5b4\ub311\ud130\uac00 BLE \uc2e0\ud638\ub97c \uc218\uc2e0\ud560 \uc218\ub9cc \uc788\uace0 \uae30\uae30\uc5d0 \ucd94\uac00 \ub370\uc774\ud130\ub97c \uc694\uccad\ud560 \uc218 \uc5c6\uc73c\ubbc0\ub85c \uae30\uae30 \uac80\uc0c9\uacfc \uae30\ub2a5\uc5d0 \uc601\ud5a5\uc744 \uc90d\ub2c8\ub2e4.\n\n**\uc218\ub3d9 \uc870\uce58 \ud544\uc694:**\n1. **USB \uc5b4\ub311\ud130\ub97c \ubd84\ub9ac\ud569\ub2c8\ub2e4.**\n2. 5\ucd08 \ub3d9\uc548 \uae30\ub2e4\ub9bd\ub2c8\ub2e4.\n3. **USB \uc5b4\ub311\ud130\ub97c \ub2e4\uc2dc \uc5f0\uacb0\ud569\ub2c8\ub2e4.**\n4. Home Assistant\uac00 \uc5b4\ub311\ud130\ub97c \uac10\uc9c0\ud560 \ub54c\uae4c\uc9c0 \uae30\ub2e4\ub9bd\ub2c8\ub2e4.\n\n\uc804\uc6d0\uc744 \uaed0\ub2e4 \ucf20 \ud6c4\uc5d0\ub3c4 \ubb38\uc81c\uac00 \uc9c0\uc18d\ub418\uba74:\n- \ub2e4\ub978 USB \ud3ec\ud2b8\ub97c \uc0ac\uc6a9\ud574 \ubcf4\uc138\uc694.\n- \ucee4\ub110/\ud38c\uc6e8\uc5b4 \uc5c5\ub370\uc774\ud2b8\ub97c \ud655\uc778\ud558\uc138\uc694.\n- \ub2e4\ub978 \ube14\ub8e8\ud22c\uc2a4 \uc5b4\ub311\ud130 \uc0ac\uc6a9\uc744 \uace0\ub824\ud574 \ubcf4\uc138\uc694.",
            "title": "\ube14\ub8e8\ud22c\uc2a4 USB \uc5b4\ub311\ud130\ub294 \uc218\ub3d9\uc73c\ub85c \uc804\uc6d0\uc744 \uaed0\ub2e4 \ucf1c\uc57c \ud569\ub2c8\ub2e4."
        }
