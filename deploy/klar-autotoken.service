[Unit]
Description=klar auto-token proxy (为 klar UI 自动补 x-klar-token，不再弹 401)
After=network.target klar-nlu-engine.service
Wants=klar-nlu-engine.service

[Service]
Type=simple
WorkingDirectory=/mnt/data/klar
Environment=KLAR_TOKEN_FILE=/mnt/data/klar/.klar-token
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /mnt/data/klar/klar_autotoken.py --port 10521 --upstream http://127.0.0.1:10520
Restart=on-failure
RestartSec=5
MemoryMax=96M
StandardOutput=append:/mnt/data/klar/autotoken.log
StandardError=append:/mnt/data/klar/autotoken.log

[Install]
WantedBy=multi-user.target
#
# 说明：这个代理把 klar 的写权限开放给任何能访问 10521 的人（自动补 token）。
# 只在家庭内网用。要对公网暴露必须自己加鉴权。
