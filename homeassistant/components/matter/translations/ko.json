    "issues": {
        "ipv6_disabled": {
            "description": "Matter\ub294 \uc77c\ubd80 \uae30\uae30\uc640 \ud1b5\uc2e0\ud560 \ub54c IPv6\uc5d0 \uc758\uc874\ud558\uc9c0\ub9cc, \uc5f0\uacb0\ub41c \ubaa8\ub4e0 \ub124\ud2b8\uc6cc\ud06c \uc778\ud130\ud398\uc774\uc2a4\uc5d0\uc11c IPv6\uac00 \ube44\ud65c\uc131\ud654\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \ub85c\uceec\ub85c \uc5f0\uacb0\ub41c Wi-Fi \ubc0f \uc774\ub354\ub137 \uae30\uae30\ub294 \uacc4\uc18d \uc791\ub3d9\ud560 \uc218 \uc788\uc9c0\ub9cc, \uc678\ubd80 Thread \ubcf4\ub354 \ub77c\uc6b0\ud130 \uc0ac\uc6a9\uacfc \uac19\uc740 \uae30\ub2a5\uc5d0\ub294 IPv6\ub97c \ud65c\uc131\ud654\ud574\uc57c \ud569\ub2c8\ub2e4. \ub124\ud2b8\uc6cc\ud06c \uc124\uc815\uc744 \uc5f4\ub824\uba74 \"\uc790\uc138\ud788 \uc54c\uc544\ubcf4\uae30\"\ub97c \uc120\ud0dd\ud558\uc138\uc694.",
            "title": "IPv6\uac00 \ube44\ud65c\uc131\ud654\ub418\uc5b4 \uc788\uc9c0\ub9cc Matter\uc5d0\ub294 \ud544\uc694\ud569\ub2c8\ub2e4"
        },
        "server_version_version_too_new": {
            "description": "\ud604\uc7ac \uc0ac\uc6a9 \uc911\uc778 Matter Server \ubc84\uc804\uc774 Home Assistant \ubc84\uc804\uacfc \ud638\ud658\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. Home Assistant\ub97c \uc5c5\ub370\uc774\ud2b8\ud558\uac70\ub098 Matter Server\ub97c \uc774\uc804 \ubc84\uc804\uc73c\ub85c \ub2e4\uc6b4\uadf8\ub808\uc774\ub4dc\ud558\uc5ec \uc774 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uc138\uc694.",
            "title": "Matter Server\uc758 \uc774\uc804 \ubc84\uc804\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."
        },
        "server_version_version_too_old": {
            "description": "\ud604\uc7ac \uc0ac\uc6a9 \uc911\uc778 Matter Server \ubc84\uc804\uc774 Home Assistant \ubc84\uc804\uacfc \ud638\ud658\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc774 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\ub824\uba74 Matter Server\ub97c \ucd5c\uc2e0 \ubc84\uc804\uc73c\ub85c \uc5c5\ub370\uc774\ud2b8\ud558\uc138\uc694.",
            "title": "Matter Server\uc758 \ucd5c\uc2e0 \ubc84\uc804\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."
