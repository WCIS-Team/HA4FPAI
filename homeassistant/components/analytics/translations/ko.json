    "preview_features": {
        "snapshots": {
            "description": "\uc800\ud76c\ub294 [\uc624\ud508 \ud648 \ud30c\uc6b4\ub370\uc774\uc158 \uae30\uae30 \ub370\uc774\ud130\ubca0\uc774\uc2a4](https://www.home-assistant.io/blog/2026/02/02/about-device-database/)\ub97c \uad6c\ucd95\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ub370\uc774\ud130\ubca0\uc774\uc2a4\ub294 \uc0ac\uc6a9\uc790\ub4e4\uc774 \uc2e4\uc81c \uc124\uce58 \ud658\uacbd\uc5d0\uc11c \uc2a4\ub9c8\ud2b8 \ud648 \uae30\uae30\uc758 \uc131\ub2a5\uc5d0 \ub300\ud55c \uc2e4\uc6a9\uc801\uc778 \uc815\ubcf4\ub97c \ucc3e\uc744 \uc218 \uc788\ub3c4\ub85d \ub3d5\ub294 \ubb34\ub8cc \uc624\ud508 \uc18c\uc2a4 \ucee4\ubba4\ub2c8\ud2f0 \uae30\ubc18 \ub9ac\uc18c\uc2a4\uc785\ub2c8\ub2e4.\n\uae30\uae30\uc5d0 \ub300\ud55c \uc775\uba85\ud654\ub41c \ub370\uc774\ud130 \uacf5\uc720\uc5d0 \ub3d9\uc758\ud574 \uc8fc\uc2dc\uba74 \uc774 \uc11c\ube44\uc2a4\ub97c \uad6c\ucd95\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \uc774 \ub370\uc774\ud130\uc5d0\ub294 \uae30\uae30\ubcc4 \uc138\ubd80 \uc815\ubcf4(\ubaa8\ub378 \ub610\ub294 \uc81c\uc870\uc5c5\uccb4 \ub4f1)\ub9cc \ud3ec\ud568\ub418\uba70, \uc0ac\uc6a9\uc790\uac00 \uc9c0\uc815\ud55c \uc774\ub984\uacfc \uac19\uc740 \uac1c\uc778 \uc2dd\ubcc4 \uc815\ubcf4\ub294 \uc808\ub300 \ud3ec\ud568\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n(\ub370\uc774\ud130 \uc81c\uacf5\uc5d0 \ub3d9\uc758\ud558\uc2dc\ub294 \uacbd\uc6b0) \uc0ac\uc6a9\uc790\uc758 \ub370\uc774\ud130\uac00 \uc5b4\ub5bb\uac8c \ucc98\ub9ac\ub418\ub294\uc9c0\uc5d0 \ub300\ud55c \uc790\uc138\ud55c \ub0b4\uc6a9\uc740 [\ub370\uc774\ud130 \uc0ac\uc6a9 \uc815\ucc45](https://www.openhomefoundation.org/device-database-data-use-statement)\uc5d0\uc11c \ud655\uc778\ud558\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
            "disable_confirmation": "\uc0ac\uc6a9\uc790\uc758 \ub370\uc774\ud130\ub294 \ub354 \uc774\uc0c1 \uc624\ud508\ud648\uc7ac\ub2e8\uc758 \uae30\uae30 \ub370\uc774\ud130\ubca0\uc774\uc2a4\uc640 \uacf5\uc720\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
            "enable_confirmation": "\uc774 \uae30\ub2a5\uc740 \uc544\uc9c1 \uac1c\ubc1c \uc911\uc774\uba70 \ubcc0\uacbd\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uae30\uae30 \ub370\uc774\ud130\ubca0\uc774\uc2a4\ub294 \uc0ac\uc6a9\uc790 \ud53c\ub4dc\ubc31\uc744 \uae30\ubc18\uc73c\ub85c \uac1c\uc120\ub418\uace0 \uc788\uc73c\uba70 \uc544\uc9c1 \uc644\uc131\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4.",
            "name": "\uae30\uae30 \ub370\uc774\ud130\ubca0\uc774\uc2a4"
        }
    }
