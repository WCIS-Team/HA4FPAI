[Unit]
Description=HA4FPAI unified console (voice chain + klar + board APIs, one page)
After=network.target klar-nlu-engine.service klar-voice-gateway.service

[Service]
Type=simple
WorkingDirectory=/mnt/data/klar
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /mnt/data/klar/console.py --port 10900
Restart=on-failure
RestartSec=5
# http.server + 标准库，很轻
MemoryMax=96M
StandardOutput=append:/mnt/data/klar/console.log
StandardError=append:/mnt/data/klar/console.log

[Install]
WantedBy=multi-user.target
